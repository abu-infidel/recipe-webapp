# Copy to worker/.env on the VPS. Never commit the real file.

# --- the site -------------------------------------------------------------
SITE_URL=https://example.ir
SITE_TOKEN=wk_...                 # from: php tools/worker-token.php "vps-name"
SITE_HMAC_SECRET=...              # must equal worker.hmac_secret in config.local.php
WORKER_ID=vps-paris

# --- the model ------------------------------------------------------------
# Any OpenAI-compatible endpoint. DeepSeek is the default; point it elsewhere
# without touching code.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=deepseek-chat           # DeepSeek ships deepseek-chat and
                                  # deepseek-reasoner. There is no "flash".
LLM_MODEL_REASONING=deepseek-reasoner
# The judge that reviews contributors' submissions. Defaults to LLM_MODEL.
LLM_JUDGE_MODEL=
LLM_MAX_TOKENS=8000

# --- web search -----------------------------------------------------------
# tavily | brave | searxng | none
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-...
BRAVE_API_KEY=
SEARXNG_URL=http://127.0.0.1:8888

# --- images ---------------------------------------------------------------
# openai | none
IMAGE_PROVIDER=none
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1

# --- limits ---------------------------------------------------------------
POLL_SECONDS=20
MAX_SOURCES_PER_ARTICLE=12
DAILY_BUDGET_USD=5
REQUEST_TIMEOUT_MS=120000
